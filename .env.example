# Application Settings
APP_NAME=CurriculumRepository
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database Configuration
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/curriculum_db
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=curriculum_content
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Settings
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# File Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes
ALLOWED_EXTENSIONS=.pdf,.docx,.md,.tex,.mp4,.mp3,.jpg,.png,.gif

# CDN & Storage
CDN_URL=https://cdn.example.com
S3_BUCKET=curriculum-content
S3_REGION=us-east-1

# External Services
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=curriculum

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_BATCH_SIZE=100

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-password
EMAIL_FROM=noreply@curriculum.example.com

# Feature Flags
ENABLE_VERSIONING=true
ENABLE_ANALYTICS=true
ENABLE_AI_FEATURES=false
